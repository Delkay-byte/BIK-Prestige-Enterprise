# BIK Prestige Enterprise — PILOT Environment
# This file configures the application for the controlled real-world pilot.
#
# Usage: Copy this to .env.pilot.local and fill in the actual secrets.
# NEVER commit .env.pilot.local to version control.
#
# Start pilot mode: npm run pilot
# Or: cp .env.pilot.local .env.local && npm run dev

# Database — PostgreSQL pilot database
DATABASE_URL="postgresql://bik:CHANGE_ME@localhost:5433/bik_pilot?schema=public"

# JWT Secret — Generate a new one: openssl rand -base64 32
# NEVER reuse the development JWT secret in pilot
JWT_SECRET="CHANGE_ME_GENERATE_NEW_SECRET"

# Environment identifier — shows PILOT badge
APP_ENV="PILOT"

# Node Environment
NODE_ENV="production"
